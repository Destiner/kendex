#!/usr/bin/env bash
# Conventional commits; git-generated messages pass through.
head -1 "$1" | grep -qE '^((feat|fix|docs|chore|refactor|test|perf|ci|build)(\([a-z0-9-]+\))?!?: .{1,72}|(Merge|Revert|fixup!|squash!|amend!) .*)$' || {
  echo "commit-msg: use conventional format: type(scope): subject (subject <= 72 chars)"
  exit 1
}
